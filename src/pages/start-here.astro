---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => !data.draft);

function firstOf(seriesSlug: string) {
  const items = articles
    .filter(a => a.data.series.toLowerCase().replace(/\s+/g, '-') === seriesSlug)
    .sort((a, b) => a.data.seriesOrder - b.data.seriesOrder);
  return items[0];
}

function href(a: NonNullable<ReturnType<typeof firstOf>>) {
  const seriesSlug = a.data.series.toLowerCase().replace(/\s+/g, '-');
  const slug = a.id.replace(/\.md$/, '');
  return `/learn/${seriesSlug}/${slug}`;
}

const entryPoints = [
  { subject: 'AI at Home', blurb: 'Start with the hardware and the first working setup.', article: firstOf('ai-at-home') },
  { subject: 'Explainers', blurb: "Start with what's actually going on, without the hype.", article: firstOf('explainers') },
  { subject: 'Case Studies', blurb: 'Start with a real build and the bugs it actually hit.', article: firstOf('case-studies') },
].filter(e => e.article);
---

<BaseLayout
  title="Start Here — masterofsomething.com"
  description="What this site is, the tested promise, and where to begin — one curated entry point per subject."
>
  <article class="prose">
    <h1 class="text-4xl font-bold text-[var(--color-text-primary)] mb-6">Start here</h1>

    <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
      masterofsomething.com is a reference library, not a blog. Every guide here describes a
      system we actually built and ran — not one assembled for the article. If a guide is
      marked <strong>untested</strong>, we say so. Otherwise, assume we did the steps ourselves,
      on our own hardware, and kept the parts that went wrong.
    </p>

    <h2 class="text-2xl font-semibold mt-10 mb-4 text-[var(--color-text-primary)]">The tested promise</h2>
    <p class="my-5">
      No guide ships unless we executed the steps, or it carries an explicit "untested
      adaptation" banner. That's the whole moat: a content farm can generate a how-to. It
      cannot fake having actually run the thing.
    </p>

    <h2 class="text-2xl font-semibold mt-10 mb-4 text-[var(--color-text-primary)]">Where to begin</h2>
    <div class="grid md:grid-cols-3 gap-4 my-6 not-prose">
      {entryPoints.map(e => (
        <a
          href={href(e.article!)}
          class="block rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-5 hover:bg-[var(--color-surface-raised)] hover:border-[var(--color-accent)] transition-colors"
        >
          <div class="text-xs uppercase tracking-widest text-[var(--color-accent)] mb-2">{e.subject}</div>
          <div class="text-[var(--color-text-primary)] font-semibold mb-1">{e.article!.data.title}</div>
          <p class="text-sm text-[var(--color-text-secondary)]">{e.blurb}</p>
        </a>
      ))}
    </div>

    <p class="my-5">
      Prefer to browse? See everything by subject on the <a href="/">homepage</a>, or read
      <a href="/our-story">who's writing this</a> and why.
    </p>
  </article>
</BaseLayout>
