---
interface Props {
  type?: 'Article' | 'HowTo' | 'FAQPage';
  title: string;
  description: string;
  author: string;
  publishDate: Date;
  updatedDate?: Date;
  url: string;
}

const {
  type = 'Article',
  title,
  description,
  author,
  publishDate,
  updatedDate,
  url,
} = Astro.props;

const authorNames = author.split(/\s+and\s+/i).map(n => n.trim()).filter(Boolean);
const authorField = authorNames.length > 1
  ? authorNames.map(name => ({ '@type': 'Person', name }))
  : { '@type': 'Person', name: authorNames[0] ?? author };

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': type,
  name: title,
  headline: title,
  description,
  author: authorField,
  publisher: {
    '@type': 'Organization',
    name: 'In Practice Media',
    url: 'https://masterofsomething.com',
  },
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  mainEntityOfPage: url,
  url,
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
